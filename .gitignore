# Ignore all CSV files (menos os derivados pequenos de data/externo e data/processed)
*data/**/*.csv
!data/externo/*.csv
!data/processed/*.csv

# Ignore Excel files
*.xlsx
*.xls

# Ignore text files from data
data/**/*.TXT
data/**/*.md

# Ignore pycache
*__pycache__
# Credenciais do firmware (copiar de secrets.example.h)
codes/firmware/**/secrets.h

# Binários compilados do Arduino IDE
codes/firmware/**/build/

# Jupyter
.ipynb_checkpoints/
