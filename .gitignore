# Ignore all CSV files
*data/**/*.csv

# Ignore Excel files
*.xlsx
*.xls

# Ignore text files from data
data/**/*.TXT
data/**/*.md

# Ignore pycache
*__pycache__
# Credenciais do firmware (copiar de secrets.example.h)
codes/firmware/**/secrets.h

# Binários compilados do Arduino IDE
codes/firmware/**/build/
